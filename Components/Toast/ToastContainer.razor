@using BlazorComponentLibrary.Services

<div class="@ContainerClass" role="status" aria-live="polite" aria-atomic="false">
@foreach (var toast in VisibleToasts)
{
    var toastId = toast.Id;
    var toastDuration = toast.DurationMs;
    <div class="bcl-toast bcl-toast--@toast.Type.ToString().ToLower()" role="alert"
         @onmouseover="() => ToastService.PauseTimer(toastId)"
         @onmouseout="() => ToastService.ResumeTimer(toastId, toastDuration)">
        <span class="bcl-toast__icon" aria-hidden="true">@GetToastIcon(toast)</span>
        <span class="bcl-toast__message">@toast.Message</span>
        <button type="button"
                class="bcl-toast__close"
                aria-label="Dismiss notification"
                @onclick="() => ToastService.Dismiss(toastId)">✕</button>
    </div>
}
</div>

