@using BlazorComponentLibrary.Services

<div class="@RootClass" role="group" aria-label="Theme selector">
    <button type="button"
            class="bcl-theme-switcher__btn @(IsActive(ThemeMode.Light) ? "bcl-theme-switcher__btn--active" : "")"
            title="Light theme"
            aria-pressed="@IsActive(ThemeMode.Light).ToString().ToLower()"
            @onclick="() => Select(ThemeMode.Light)">
        <span class="bcl-icon" aria-hidden="true">☀️</span>
        @if (ShowLabel) { <span>Light</span> }
    </button>

    <button type="button"
            class="bcl-theme-switcher__btn @(IsActive(ThemeMode.System) ? "bcl-theme-switcher__btn--active" : "")"
            title="System theme"
            aria-pressed="@IsActive(ThemeMode.System).ToString().ToLower()"
            @onclick="() => Select(ThemeMode.System)">
        <span class="bcl-icon" aria-hidden="true">💻</span>
        @if (ShowLabel) { <span>System</span> }
    </button>

    <button type="button"
            class="bcl-theme-switcher__btn @(IsActive(ThemeMode.Dark) ? "bcl-theme-switcher__btn--active" : "")"
            title="Dark theme"
            aria-pressed="@IsActive(ThemeMode.Dark).ToString().ToLower()"
            @onclick="() => Select(ThemeMode.Dark)">
        <span class="bcl-icon" aria-hidden="true">🌙</span>
        @if (ShowLabel) { <span>Dark</span> }
    </button>
</div>

@code {
    // Logic is in ThemeSwitcher.razor.cs
}
