@using Microsoft.AspNetCore.Components.Web
@typeparam TItem

<div @onkeydown="OnKeyDown" @onkeyup="OnKeyUp" tabindex="0" style="outline: none;">
<table class="bcl-data-table">
<thead>
<tr>
@TableHeader
</tr>
</thead>
<tbody>
@foreach (var item in _currentViewData)
{
<tr @onclick="() => OnRowClickHandler(item)">
@RowTemplate(item)
</tr>
}
</tbody>
</table>
</div>

@code {
// This partial class is linked to DataTable.razor.cs
// The logic is in DataTable.razor.cs
}