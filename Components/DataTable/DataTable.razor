@inherits DataTable<TItem>
@typeparam TItem

<table class="bcl-data-table">
    <thead>
        <tr>
            @TableHeader
        </tr>
    </thead>
    <tbody>
        @if (EnableVirtualization)
        {
            <Virtualize Items="@_currentViewData.ToList()" Context="item">
                <tr @onclick="() => OnRowClickHandler(item)">
                    @RowTemplate(item)
                </tr>
            </Virtualize>
        }
        else
        {
            @foreach (var item in _currentViewData)
            {
                <tr @onclick="() => OnRowClickHandler(item)">
                    @RowTemplate(item)
                </tr>
            }
        }
    </tbody>
</table>

@code {
    // This partial class is linked to DataTable.razor.cs
    // The logic is in DataTable.razor.cs
}
