<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!--
      CS1591: missing XML comments flood the build; public docs are not enforced repo-wide.
      BL0005: fluent extensions (e.g. SkeletonExtensions) set [Parameter]s outside the component by design.
      BL0007: parameters with null-fallback setters (e.g. ToastContainer.Position) must stay non-auto.
    -->
    <NoWarn>$(NoWarn);CS1591;BL0005;BL0007</NoWarn>
  </PropertyGroup>

  <!-- Test projects do not ship XML documentation. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
