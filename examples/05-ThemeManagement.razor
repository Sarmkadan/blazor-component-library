 *
 * Theme Management Example
 * Demonstrates: Creating themes, CSS variables, and theme switching
 *@

@page "/examples/theme-management"
@using BlazorComponentLibrary.Models
@using BlazorComponentLibrary.Services
@inject ThemeService ThemeService
@inject NavigationManager NavigationManager

<PageTitle>Theme Management Example</PageTitle>

<div class="theme-container" style="@cssVariables">
    <h1>Theme Management Example</h1>

    <p class="example-description">
        This example shows how to create and manage themes with the Blazor Component Library.
    </p>

    <div class="theme-controls">
        <h2>Available Themes</h2>

        <div class="theme-grid">
            @foreach (var theme in predefinedThemes)
            {
                <div class="theme-card" @onclick="@(() => SelectTheme(theme))">
                    <h3>@theme.Name</h3>

                    <div class="theme-preview">
                        <div class="color-dots">
                            <span class="color-dot" style="background-color: @theme.PrimaryColor"
                                title="Primary: @theme.PrimaryColor"></span>
                            <span class="color-dot" style="background-color: @theme.SecondaryColor"
                                title="Secondary: @theme.SecondaryColor"></span>
                            <span class="color-dot" style="background-color: @theme.AccentColor"
                                title="Accent: @theme.AccentColor"></span>
                        </div>
                    </div>

                    <p class="theme-mode">@(theme.IsDarkMode ? "🌙 Dark" : "☀️ Light")</p>

                    <button class="btn btn-sm btn-primary" @onclick="@(() => SelectTheme(theme))">
                        Apply
                    </button>
                </div>
            }
        </div>
    </div>

    @if (currentTheme != null)
    {
        <div class="current-theme">
            <h2>Current Theme: @currentTheme.Name</h2>

            <div class="theme-details">
                <div class="detail-group">
                    <h3>Colors</h3>
                    <div class="color-swatches">
                        <div class="swatch">
                            <div class="color-box" style="background-color: @currentTheme.PrimaryColor"></div>
                            <p>Primary</p>
                            <code>@currentTheme.PrimaryColor</code>
                        </div>

                        <div class="swatch">
                            <div class="color-box" style="background-color: @currentTheme.SecondaryColor"></div>
                            <p>Secondary</p>
                            <code>@currentTheme.SecondaryColor</code>
                        </div>

                        <div class="swatch">
                            <div class="color-box" style="background-color: @currentTheme.AccentColor"></div>
                            <p>Accent</p>
                            <code>@currentTheme.AccentColor</code>
                        </div>

                        <div class="swatch">
                            <div class="color-box" style="background-color: @currentTheme.BackgroundColor"></div>
                            <p>Background</p>
                            <code>@currentTheme.BackgroundColor</code>
                        </div>

                        <div class="swatch">
                            <div class="color-box" style="background-color: @currentTheme.TextColor"></div>
                            <p>Text</p>
                            <code>@currentTheme.TextColor</code>
                        </div>
                    </div>
                </div>

                <div class="detail-group">
                    <h3>Theme Mode</h3>
                    <p>@(currentTheme.IsDarkMode ? "Dark Mode Enabled" : "Light Mode")</p>
                </div>

                <div class="detail-group">
                    <h3>CSS Variables</h3>
                    <p>These variables can be used in your CSS:</p>
                    <pre><code>:root {
  --primary: @currentTheme.PrimaryColor;
  --secondary: @currentTheme.SecondaryColor;
  --accent: @currentTheme.AccentColor;
  --background: @currentTheme.BackgroundColor;
  --text: @currentTheme.TextColor;
}</code></pre>
                </div>
            </div>
        </div>

        <div class="create-custom-theme">
            <h2>Create Custom Theme</h2>

            <div class="form-group">
                <label for="theme-name">Theme Name</label>
                <input type="text" id="theme-name" @bind="customThemeName" class="form-control" placeholder="e.g., Sunset Orange" />
            </div>

            <div class="color-inputs">
                <div class="color-group">
                    <label for="primary-color">Primary Color</label>
                    <div class="color-input-wrapper">
                        <input type="color" id="primary-color" @bind="customPrimary" class="color-input" />
                        <input type="text" @bind="customPrimary" class="color-text" />
                    </div>
                </div>

                <div class="color-group">
                    <label for="secondary-color">Secondary Color</label>
                    <div class="color-input-wrapper">
                        <input type="color" id="secondary-color" @bind="customSecondary" class="color-input" />
                        <input type="text" @bind="customSecondary" class="color-text" />
                    </div>
                </div>

                <div class="color-group">
                    <label for="accent-color">Accent Color</label>
                    <div class="color-input-wrapper">
                        <input type="color" id="accent-color" @bind="customAccent" class="color-input" />
                        <input type="text" @bind="customAccent" class="color-text" />
                    </div>
                </div>
            </div>

            <div class="form-group checkbox">
                <input type="checkbox" id="dark-mode" @bind="customDarkMode" />
                <label for="dark-mode">Dark Mode</label>
            </div>

            <button class="btn btn-primary" @onclick="CreateCustomTheme">Create Theme</button>
        </div>
    }

    <div class="example-actions">
        <button class="btn btn-info" @onclick="GoHome">← Back to Home</button>
    </div>
</div>

@code {
    private List<Theme> predefinedThemes = new();
    private Theme? currentTheme;
    private string cssVariables = "";

    // Custom theme inputs
    private string customThemeName = "";
    private string customPrimary = "#007bff";
    private string customSecondary = "#6c757d";
    private string customAccent = "#17a2b8";
    private bool customDarkMode = false;

    protected override void OnInitialized()
    {
        // Define predefined themes
        predefinedThemes = new List<Theme>
        {
            new Theme
            {
                Name = "Blue Sky",
                IsDarkMode = false,
                PrimaryColor = "#0066cc",
                SecondaryColor = "#6c757d",
                AccentColor = "#17a2b8",
                BackgroundColor = "#ffffff",
                TextColor = "#333333"
            },
            new Theme
            {
                Name = "Dark Night",
                IsDarkMode = true,
                PrimaryColor = "#1e293b",
                SecondaryColor = "#475569",
                AccentColor = "#0ea5e9",
                BackgroundColor = "#0f172a",
                TextColor = "#f1f5f9"
            },
            new Theme
            {
                Name = "Forest Green",
                IsDarkMode = false,
                PrimaryColor = "#059669",
                SecondaryColor = "#10b981",
                AccentColor = "#34d399",
                BackgroundColor = "#f0fdf4",
                TextColor = "#065f46"
            },
            new Theme
            {
                Name = "Sunset Orange",
                IsDarkMode = false,
                PrimaryColor = "#ea580c",
                SecondaryColor = "#fb923c",
                AccentColor = "#fed7aa",
                BackgroundColor = "#fffbf0",
                TextColor = "#7c2d12"
            }
        };

        // Set default theme
        if (predefinedThemes.Count > 0)
        {
            SelectTheme(predefinedThemes[0]);
        }
    }

    private void SelectTheme(Theme theme)
    {
        currentTheme = theme;
        UpdateCssVariables();
    }

    private void UpdateCssVariables()
    {
        if (currentTheme == null) return;

        cssVariables = $@"
            --primary: {currentTheme.PrimaryColor};
            --secondary: {currentTheme.SecondaryColor};
            --accent: {currentTheme.AccentColor};
            --background: {currentTheme.BackgroundColor};
            --text: {currentTheme.TextColor};
        ";
    }

    private async Task CreateCustomTheme()
    {
        if (string.IsNullOrWhiteSpace(customThemeName))
        {
            return;
        }

        var newTheme = new Theme
        {
            Name = customThemeName,
            IsDarkMode = customDarkMode,
            PrimaryColor = customPrimary,
            SecondaryColor = customSecondary,
            AccentColor = customAccent,
            BackgroundColor = customDarkMode ? "#1a1a1a" : "#ffffff",
            TextColor = customDarkMode ? "#f5f5f5" : "#333333"
        };

        predefinedThemes.Add(newTheme);
        SelectTheme(newTheme);

        customThemeName = "";
    }

    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }
}

<style>
    .theme-container {
        max-width: 1200px;
        margin: 20px auto;
        padding: 20px;
    }

    h1 {
        color: var(--primary);
        margin-bottom: 10px;
    }

    .example-description {
        color: #666;
        font-size: 14px;
        margin-bottom: 25px;
    }

    .theme-controls {
        margin-bottom: 40px;
    }

    .theme-controls h2 {
        color: var(--primary);
        margin-bottom: 20px;
    }

    .theme-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .theme-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        cursor: pointer;
        transition: all 0.3s;
        text-align: center;
    }

    .theme-card:hover {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transform: translateY(-2px);
    }

    .theme-card h3 {
        margin: 0 0 10px 0;
        color: var(--primary);
    }

    .theme-preview {
        margin: 10px 0;
    }

    .color-dots {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .color-dot {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1px solid #999;
    }

    .theme-mode {
        font-size: 13px;
        color: #666;
        margin: 8px 0;
    }

    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
    }

    .btn-sm {
        padding: 6px 12px;
        font-size: 12px;
    }

    .btn-primary {
        background-color: var(--primary);
        color: white;
    }

    .btn-primary:hover {
        opacity: 0.9;
    }

    .btn-info {
        background-color: var(--accent);
        color: white;
    }

    .current-theme {
        background-color: var(--background);
        color: var(--text);
        padding: 25px;
        border-radius: 8px;
        margin-bottom: 30px;
        border: 1px solid var(--primary);
    }

    .current-theme h2 {
        color: var(--primary);
        margin-top: 0;
    }

    .theme-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }

    .detail-group h3 {
        color: var(--secondary);
        margin-top: 0;
    }

    .color-swatches {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .swatch {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .color-box {
        width: 50px;
        height: 50px;
        border-radius: 4px;
        border: 1px solid #999;
        flex-shrink: 0;
    }

    .swatch p {
        margin: 0;
        font-weight: 500;
    }

    .swatch code {
        font-size: 12px;
        color: #666;
        font-family: monospace;
    }

    pre {
        background-color: rgba(0, 0, 0, 0.05);
        padding: 12px;
        border-radius: 4px;
        overflow-x: auto;
        font-size: 12px;
    }

    .create-custom-theme {
        background-color: #f9f9f9;
        padding: 25px;
        border-radius: 8px;
        margin-bottom: 30px;
    }

    .create-custom-theme h2 {
        color: var(--primary);
        margin-top: 0;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 14px;
    }

    .color-inputs {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 15px;
        margin-bottom: 15px;
    }

    .color-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .color-input-wrapper {
        display: flex;
        gap: 8px;
    }

    .color-input {
        width: 50px;
        height: 40px;
        border: 1px solid #ccc;
        border-radius: 4px;
        cursor: pointer;
    }

    .color-text {
        flex: 1;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 13px;
        font-family: monospace;
    }

    .checkbox {
        display: flex;
        align-items: center;
    }

    .checkbox input[type="checkbox"] {
        margin-right: 8px;
    }

    .checkbox label {
        margin-bottom: 0;
    }

    .example-actions {
        text-align: center;
        margin-top: 30px;
    }
</style>
