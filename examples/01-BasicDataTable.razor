        max-width: 1000px;
        margin: 20px auto;
        padding: 20px;
    }

    .example-description {
        color: #666;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .controls {
        margin-bottom: 20px;
    }

    .controls button {
        margin-right: 10px;
        margin-bottom: 10px;
    }

    .table-container {
        margin-top: 20px;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    .data-table thead {
        background-color: #f5f5f5;
    }

    .data-table th,
    .data-table td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #ddd;
    }

    .data-table tbody tr:hover {
        background-color: #f9f9f9;
    }

    .badge {
        padding: 5px 10px;
        border-radius: 3px;
        font-size: 12px;
    }

    .badge-success {
        background-color: #28a745;
        color: white;
    }

    .badge-warning {
        background-color: #ffc107;
        color: black;
    }

    .table-info {
        margin-top: 15px;
        color: #666;
    }

    .spinner {
        text-align: center;
        padding: 20px;
        color: #666;
    }

    .no-data {
        text-align: center;
        padding: 40px;
        color: #999;
    }

    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 4px;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

    .btn-secondary:hover {
        background-color: #545b62;
    }

    .btn-info {
        background-color: #17a2b8;
        color: white;
    }

    .btn-info:hover {
        background-color: #117a8b;
    }
</style>
